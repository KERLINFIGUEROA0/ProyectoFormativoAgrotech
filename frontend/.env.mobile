# Variables de entorno para desarrollo móvil
# Copia este archivo como .env.local y ajusta los valores según tu configuración

# URL del backend para desarrollo móvil
# En desarrollo: IP de tu computadora en la red local
# En producción: URL pública de tu servidor
VITE_MOBILE_BACKEND_URL=http://192.168.1.10:3000

# URL para emulador Android (apunta a localhost de la máquina host)
VITE_EMULATOR_BACKEND_URL=http://10.0.2.2:3000

# URL del backend para iOS Simulator
VITE_IOS_BACKEND_URL=http://localhost:3000

# URL del backend para producción
VITE_PRODUCTION_BACKEND_URL=https://tu-backend-production.com

# Configuración de WebSockets para móvil
VITE_MOBILE_WS_URL=ws://192.168.1.10:3000
VITE_PRODUCTION_WS_URL=wss://tu-backend-production.com