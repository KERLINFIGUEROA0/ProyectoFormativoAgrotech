		<div class="container">
			<a href="/" class="back-link">← Volver al inicio</a>
			<div class="module-header">
				<h1>Módulo Usuarios</h1>
			</div>

			<h2>Endpoints</h2>
			{endpoints.map(endpoint => (
				<div class="endpoint">
					<h3>{endpoint.method} {endpoint.path}</h3>
					<p><strong>URL completa:</strong> <code>http://localhost:3000{endpoint.path}</code></p>
					<p><strong>Descripción:</strong> {endpoint.description}</p>
					{endpoint.request && (
						<div>
							<strong>Request Body:</strong>
							<pre class="request-code">{endpoint.request}</pre>
						</div>
					)}
					{endpoint.params && endpoint.params.length > 0 && (
						<div>
							<strong>Parámetros:</strong>
							<pre class="params-code">{endpoint.params.join('\n')}</pre>
						</div>
					)}
					{endpoint.response && (
						<div>
							<strong>Respuesta:</strong>
							<pre class="response-code">{endpoint.response}</pre>
						</div>
					)}
				</div>
			))}

			<div class="dto-box">
				<h3>Entidad Usuario</h3>
